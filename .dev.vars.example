# Copy this file to .dev.vars for local development, then replace the placeholders.
# Never commit .dev.vars or share these values publicly.
# Use a dedicated Neon branch for local development, never the production main branch.
# Apply migrations to that branch with: npm run db:migrate
ENVIRONMENT=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
AWS_ENDPOINT_URL_S3=https://YOUR-BRANCH.storage.c-REGION.aws.neon.tech
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=YOUR_NEON_STORAGE_TOKEN_ID
AWS_SECRET_ACCESS_KEY=YOUR_NEON_STORAGE_SECRET
OBJECT_STORAGE_BUCKET=northstar-assets

# Built-in Admin Auth credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<generate with: openssl rand -base64 24>
ADMIN_JWT_SECRET=<generate with: openssl rand -hex 32>

# Optional: Cloudflare Access JWT validation
CF_ACCESS_TEAM_DOMAIN=YOUR_TEAM.cloudflareaccess.com
CF_ACCESS_AUD=YOUR_ACCESS_APPLICATION_AUD

# Optional: Cloudflare Turnstile contact-form protection
# Set both values in production; leave blank locally to disable the challenge.
TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=YOUR_TURNSTILE_SECRET_KEY

# Optional: rebuild static SEO metadata after CMS saves
# Fine-grained GitHub token with Contents: write for this repository.
GITHUB_DISPATCH_TOKEN=YOUR_GITHUB_FINE_GRAINED_TOKEN
GITHUB_REPO=frizqon/northstar-it-services
