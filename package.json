{
  "name": "northstar-it-services",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev --ip 127.0.0.1",
    "build": "astro build",
    "preview": "wrangler dev --ip 127.0.0.1",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/preact": "^4.1.0",
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-presigned-post": "^3.1164.0",
    "@neondatabase/serverless": "^1.0.2",
    "astro": "^5.14.1",
    "hono": "^4.9.8",
    "jose": "^6.1.0",
    "preact": "^10.27.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.38.0"
  }
}
