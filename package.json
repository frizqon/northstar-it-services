{
  "name": "northstar-it-services",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev --ip 127.0.0.1",
    "build": "astro build",
    "preview": "wrangler dev --ip 127.0.0.1",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "dbmate --migrations-dir db/migrations --schema-file schema.sql up",
    "db:rollback": "dbmate --migrations-dir db/migrations --schema-file schema.sql down",
    "db:status": "dbmate --migrations-dir db/migrations --schema-file schema.sql status",
    "db:new": "dbmate --migrations-dir db/migrations --schema-file schema.sql new"
  },
  "dependencies": {
    "@astrojs/preact": "^6.1.2",
    "@astrojs/sitemap": "^3.7.4",
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-presigned-post": "^3.1164.0",
    "@neondatabase/serverless": "^1.0.2",
    "astro": "^7.4.7",
    "hono": "^4.9.8",
    "jose": "^6.1.0",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "dbmate": "^2.37.0",
    "typescript": "^5.9.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.38.0"
  }
}
